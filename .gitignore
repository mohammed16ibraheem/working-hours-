# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies / build (regenerable — not app data)
/node_modules
/Backend/node_modules
/Backend/.venv
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env / secrets — never commit (user creates real .env locally)
.env
.env.*
!.env.example
!.env*.example
credentials.json
**/secrets/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# OCR / face models (large downloaded caches — reinstall via app/deps)
/Backend/models/
**/insightface/
**/.EasyOCR/
**/torch/hub/

# temp / OS
*.tmp
*.temp
*.swp
*~
Thumbs.db
