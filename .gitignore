# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/Backend/node_modules
/Backend/.venv
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env / secrets — never commit
.env
.env.*
!.env.example
!.env*.example
*.pem
credentials.json
**/secrets/
**/*secret*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# OCR / face models (large downloaded caches)
/Backend/models/
**/insightface/
**/.EasyOCR/
**/torch/hub/

# runtime / blob data (keep templates & app code)
/Backend/data/attendance/
/Backend/data/imports/
/Backend/data/timesheets/
/Backend/data/user/
/Backend/data/*.migrated
/Backend/data/*.pre-tree
/Backend/data/attendance_links.json
/Backend/data/attendance_logs.json
/Backend/data/attendance_rejects.json
/Backend/data/unmatched_attendance.json
/Backend/data/.test-commit-merge-marker

# temp / OS
*.tmp
*.temp
*.swp
*~
.DS_Store
Thumbs.db
